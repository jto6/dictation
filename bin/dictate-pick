#!/usr/bin/env bash
# dictate-pick — pick recording mode + post-cmd in one shot.
# Does not start recording; press the toggle shortcut (Super+Z) after selecting.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DAEMON="$SCRIPT_DIR/start-dictation-daemon.sh"
STATE_DIR=/tmp/whisper-dictation
HISTORY_FILE="$STATE_DIR/mode-history"
mkdir -p "$STATE_DIR"

# Read recency-ordered history (one label per line, most recent first)
history_modes=()
if [ -s "$HISTORY_FILE" ]; then
	while IFS= read -r line; do
		[ -n "$line" ] && history_modes+=("$line")
	done < "$HISTORY_FILE"
fi

# Each entry: "<recording-mode>|<post-cmd>|<display-label>"
# Streaming is always raw (phrase-by-phrase rewrite would stutter).
declare -a entries=(
  "streaming|raw|streaming (real-time, raw)"
  "batch|text-clean --backend local -basic|text-clean -basic (local)"
  "batch|text-clean --backend local -journal|text-clean -journal (local)"
  "batch|text-clean --backend local -conversational|text-clean -conversational (local)"
  "batch|text-clean --backend local|text-clean (local)"
  "batch|text-clean -basic|text-clean -basic"
  "batch|text-clean -journal|text-clean -journal"
  "batch|text-clean -conversational|text-clean -conversational"
  "batch|text-clean|text-clean"
  "batch|bulletize --backend local -journal|bulletize -journal (local)"
  "batch|bulletize --backend local -conversational|bulletize -conversational (local)"
  "batch|bulletize --backend local|bulletize (local)"
  "batch|bulletize --backend local -journal -mmap|bulletize -journal -mmap (local)"
  "batch|bulletize --backend local -mmap|bulletize -mmap (local)"
  "batch|bulletize -journal|bulletize -journal"
  "batch|bulletize -conversational|bulletize -conversational"
  "batch|bulletize|bulletize"
  "batch|bulletize -journal -mmap|bulletize -journal -mmap"
  "batch|bulletize -mmap|bulletize -mmap"
  "batch|raw|batch (raw, no rewrite)"
)

# Build menu: history order first (most-recent at top), then never-used entries
menu_items=()
declare -A _in_menu

# Add history items in recency order; mark the most recent with ↻
_first_history=1
for _mode in "${history_modes[@]}"; do
	# Only include labels that still exist in the entries list
	for e in "${entries[@]}"; do
		if [ "${e##*|}" = "$_mode" ]; then
			if [ "$_first_history" -eq 1 ]; then
				menu_items+=("↻ $_mode")
				_first_history=0
			else
				menu_items+=("$_mode")
			fi
			_in_menu["$_mode"]=1
			break
		fi
	done
done

# Append entries not yet in menu (never used), in original order
for e in "${entries[@]}"; do
	label="${e##*|}"
	[ -z "${_in_menu[$label]:-}" ] && menu_items+=("$label")
done

# --- Picker: fzf-in-terminal > rofi > zenity ---

pick=""

FZF_BIN=$(command -v fzf 2>/dev/null || true)
[ -z "$FZF_BIN" ] && [ -x /home/jon/installedSW/fzf/bin/fzf ] && FZF_BIN=/home/jon/installedSW/fzf/bin/fzf

TERM_CMD=()
if command -v ghostty >/dev/null 2>&1; then
	TERM_CMD=(ghostty --gtk-single-instance=false --title="Dictate mode" -e)
elif command -v xterm >/dev/null 2>&1; then
	TERM_CMD=(xterm -geometry 64x16 -title "Dictate mode" -e)
fi

key_used=""

if [ -n "$FZF_BIN" ] && [ ${#TERM_CMD[@]} -gt 0 ]; then
	menu_file=$(mktemp /tmp/dictate-pick.XXXXXX)
	result_file=$(mktemp /tmp/dictate-pick.XXXXXX)
	done_file=$(mktemp -u /tmp/dictate-pick.XXXXXX)
	helper=$(mktemp /tmp/dictate-pick.XXXXXX)
	printf '%s\n' "${menu_items[@]}" > "$menu_file"
	# --expect causes fzf to print the key name on line 1 and the selection on line 2.
	# alt-enter = one-shot (apply for next dictation only, then restore previous mode)
	cat > "$helper" <<-EOF
		#!/usr/bin/env bash
		"$FZF_BIN" --prompt='Mode (alt-enter=one-shot): ' --height=100% --reverse --no-sort \
			--expect=alt-enter < "$menu_file" > "$result_file" || true
		: > "$done_file"
	EOF
	chmod +x "$helper"
	# Ghostty's process may linger after the inner command exits, so don't `wait` on it.
	# Just poll for the helper's done sentinel.
	"${TERM_CMD[@]}" "$helper" >/dev/null 2>&1 &
	while [ ! -e "$done_file" ]; do sleep 0.1; done
	# With --expect, fzf outputs: line 1 = pressed key (empty for plain Enter), line 2 = selection
	key_used=$(head -1 "$result_file")
	pick=$(tail -1 "$result_file")
	rm -f "$menu_file" "$result_file" "$done_file" "$helper"
elif command -v rofi >/dev/null 2>&1; then
	pick=$(printf '%s\n' "${menu_items[@]}" | \
		rofi -dmenu -i -p "Dictate" -lines 12 \
		-theme-str 'window {width: 32em;}') || true
elif command -v zenity >/dev/null 2>&1; then
	pick=$(zenity --list --column=Mode \
		--title="Dictate" --hide-header --width=420 --height=420 \
		"${menu_items[@]}") || true
else
	notify-send "dictate-pick: install fzf, rofi, or zenity"
	exit 1
fi

[ -z "$pick" ] && exit 0

# alt-enter = one-shot (apply mode for next dictation only, then auto-restore)
one_shot=false
if [ "$key_used" = "alt-enter" ]; then
	one_shot=true
fi

# Strip "↻ " prefix if present (marks the most-recently-used item)
case "$pick" in
	"↻ "*) pick="${pick#↻ }" ;;
esac

# Look up entry by display label to recover (recording_mode, post_cmd)
rec_mode=""; post_cmd=""
for e in "${entries[@]}"; do
	if [ "${e##*|}" = "$pick" ]; then
		rec_mode="${e%%|*}"
		rest="${e#*|}"
		post_cmd="${rest%%|*}"
		break
	fi
done

if [ -z "$rec_mode" ]; then
	notify-send "dictate-pick: unrecognized selection: $pick"
	exit 1
fi

if $one_shot; then
	"$DAEMON" one-shot "$rec_mode" "$post_cmd" >/dev/null
	notify-send "Dictate (one-shot): $pick"
else
	"$DAEMON" set-mode "$rec_mode" >/dev/null
	"$DAEMON" post-cmd "$post_cmd" >/dev/null

	# Update history: selected mode first, then previous history entries (deduped)
	{
		echo "$pick"
		for _mode in "${history_modes[@]}"; do
			[ "$_mode" != "$pick" ] && echo "$_mode"
		done
	} > "$HISTORY_FILE"

	notify-send "Dictate: $pick"
fi
